# Copy this file to `.env` and paste in your own keys.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.
#
# ONLY ONE KEY IS STRICTLY REQUIRED: LOCALPIPE_KEY.
# Everything else is optional and the pipeline degrades gracefully without it.

# --- REQUIRED: owner name + email (stage 3), and the default scraper ---
# https://localpipe.io  ->  dashboard  ->  API key (starts with lp_)
# Credits are charged only when data is found.
# With just this key you can run the ENTIRE pipeline:
#   python scrape.py --provider localpipe
LOCALPIPE_KEY=lp_your_localpipe_key_here

# --- OPTIONAL: alternative scraper for stage 1 ---
# https://scraper.tech  ->  Panel  ->  Google Maps API  ->  API Key
# Bills per REQUEST, not per result -- one request can return 200+ businesses,
# so it is much cheaper for large or repeated scrapes, and it is synchronous.
# Leave this blank to scrape with LocalPipe instead. See the README comparison.
SCRAPERTECH_KEY=

# --- OPTIONAL: waterfall fallback when LocalPipe finds no email (stage 4a) ---
# https://ai-ark.com  ->  developer portal
# Recovered 73 of 284 emails in the reference run. Omit to skip this step.
AIARK_KEY=

# --- OPTIONAL: waterfall fallback after AI Ark (stage 4b) ---
# https://prospeo.io  ->  https://app.prospeo.io/api  (starts with pk_)
# 1 credit per successful enrichment, free on no-match. Omit to skip this step.
PROSPEO_KEY=
